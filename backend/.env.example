# Copy this file to backend/.env and replace every placeholder.
# Never commit backend/.env or real secrets.

SECRET_KEY=change-me-in-production
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# OAuth callback base. Register the callback URLs below in each developer app.
# Replace this temporary URL whenever ngrok gives you a new URL.
OAUTH_REDIRECT_BASE=https://salvaging-mayflower-untimely.ngrok-free.dev
FRONTEND_BASE=http://localhost:5173

# Callback URLs:
# https://salvaging-mayflower-untimely.ngrok-free.dev/api/connections/facebook/oauth/callback
# https://salvaging-mayflower-untimely.ngrok-free.dev/api/connections/instagram/oauth/callback
# https://salvaging-mayflower-untimely.ngrok-free.dev/api/connections/linkedin/oauth/callback
# https://salvaging-mayflower-untimely.ngrok-free.dev/api/connections/x/oauth/callback
# https://salvaging-mayflower-untimely.ngrok-free.dev/api/connections/tiktok/oauth/callback
# https://salvaging-mayflower-untimely.ngrok-free.dev/api/connections/youtube/oauth/callback

# Official developer consoles:
# Meta / Facebook / Instagram: https://developers.facebook.com/apps/
# Meta Business Manager: https://business.facebook.com/settings/
# LinkedIn Developers: https://www.linkedin.com/developers/apps
# LinkedIn Campaign Manager: https://www.linkedin.com/campaignmanager/
# X Developer Portal: https://developer.x.com/en/portal/dashboard
# TikTok for Developers: https://developers.tiktok.com/
# TikTok Ads Manager: https://ads.tiktok.com/
# Google Cloud credentials: https://console.cloud.google.com/apis/credentials
# Google Ads API: https://ads.google.com/aw/apicenter

# OAuth client credentials.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=

# Advertising account identifiers.
# These are IDs, not secrets. Obtain them from the corresponding ad console.
META_AD_ACCOUNT_ID=act_123456789
META_BUSINESS_ID=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_AD_ACCOUNT_URN=urn:li:sponsoredAccount:123456
X_AD_ACCOUNT_ID=
TIKTOK_ADVERTISER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
